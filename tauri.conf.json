{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESK CODE",
  "version": "0.1.0",
  "identifier": "ai.radch.eskcode",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev:tauri",
      "cwd": "ui"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "ui"
    },
    "frontendDist": "ui/build"
  },
  "app": {
    "windows": [
      {
        "title": "ESK CODE",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
