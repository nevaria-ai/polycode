{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESK CODE",
  "version": "0.1.0",
  "identifier": "ai.radch.eskcode",
  "build": {
    "beforeDevCommand": {
      "script": "bun --bun run vite dev",
      "cwd": "ui"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "bun --bun run vite build",
      "cwd": "ui"
    },
    "frontendDist": "ui/build"
  },
  "app": {
    "windows": [
      {
        "title": "ESK CODE",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "description": "Main window capability. Custom commands are callable by default once this exists; core:event enables the app-wide event broadcasts (emit/listen).",
          "windows": ["main"],
          "permissions": ["core:event:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
